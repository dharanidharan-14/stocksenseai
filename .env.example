# Database
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/stocksense_ai
DATABASE_URL_SYNC=postgresql://postgres:yourpassword@localhost:5432/stocksense_ai

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application
APP_NAME=StockSense AI
APP_ENV=development
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Timezone (for the shop)
SHOP_TIMEZONE=Asia/Kolkata

# Gemini AI (Conversational Inventory Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
